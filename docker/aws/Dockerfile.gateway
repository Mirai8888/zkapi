FROM nginx:1.28-alpine

# Public proving artifacts must come from the same checkout as the daemon image:
# the ceremony setup of circuit zkapi-v2-concession-v1. nginx serves only
# request.pk, withdrawal.pk and manifest.json; until G-SETUP commits the keys
# those routes answer 404.
COPY protocol/setup/v2-concession/ /srv/zkapi/proofs/
COPY docker/aws/nginx.conf /etc/nginx/nginx.conf
