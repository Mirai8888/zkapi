# Private challenge-signer settings. Install as /etc/zkapi/signer.env, owned by
# root with mode 0600. Only the signer container reads this file; keep the key
# out of every other environment file. See signer/README.md.
ZKAPI_CHALLENGE_PRIVATE_KEY=REPLACE_WITH_DEDICATED_SENDER_PRIVATE_KEY
ZKAPI_CHALLENGE_CHAIN_ID=11155111
ZKAPI_CHALLENGE_RPC_URL=https://REPLACE_WITH_UPSTREAM_RPC_FOR_THE_CHAIN
ZKAPI_CHALLENGE_VAULT=REPLACE_WITH_VAULT_ADDRESS

# EIP-1559 fee cap in wei: the highest maxFeePerGas the signer signs. Required
# when ZKAPI_CHALLENGE_CHAIN_ID=1 (Sepolia defaults to 10 gwei). Choose at least
# the worst base fee to survive x 1.125 + the tip. The placeholder is refused.
ZKAPI_CHALLENGE_MAX_FEE_PER_GAS_WEI=REPLACE_WITH_FEE_CAP_WEI

# Optional, shown with their defaults (positive decimal integers; empty = default).
# Tip of a bid made without proposed fees: min(1 gwei, tip cap).
#ZKAPI_CHALLENGE_PRIORITY_FEE_PER_GAS_WEI=1000000000
# Highest tip the signer signs: min(fee cap, 10 x the default tip).
#ZKAPI_CHALLENGE_MAX_PRIORITY_FEE_PER_GAS_WEI=10000000000
# Typo guard for the fee cap: 10,000 gwei, at most 1,000,000 gwei.
#ZKAPI_CHALLENGE_FEE_CEILING_WEI=10000000000000
#ZKAPI_CHALLENGE_MAX_GAS=12000000

# Funding: hold at least (N + K) x gas limit x fee cap, where N is the number of
# challenges that may be pending at once and K a budget of reverted attempts.
# A real challenge uses a gas limit of about 7.53M: 0.75 ETH per challenge at a
# 100 gwei cap. ZKAPI_CHALLENGE_MAX_GAS_PRICE_WEI is no longer supported; the
# signer refuses to start while it is present.
