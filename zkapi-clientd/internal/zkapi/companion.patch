+            &note.contract_address, &next_commitment.x, &next_commitment.y, &next_anchor);
+        let settled_payload = json!({"type":"oa_org_unissued_lease_cancellation", "billing_quote":quote}).to_string();
+        let response = RequestResponseV2 {
+            status:"finalized".into(), client_request_id:request.client_request_id.clone(), request_nullifier:nullifier,
+            response_code:200, response_hash:zkapi_types::canonical_response_hash(settled_payload.as_bytes()),
+            response_payload:settled_payload, charge_applied:0, next_commitment, next_anchor,
+            blind_delta_srv:Felt252::ONE, next_state_signature:signer.sign(&message),
