+//! Native ETH quote checks. Never trust the payment server's conversion alone.
+use crate::{config::AuthConfig, error::AuthError};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Quote {
+    pub asset: String,
+    pub units_per_eth: u64,
+    pub chain_id: u64,
+    pub feed_address: String,
+    pub round_id: String,
+    pub answer: String,
+    pub decimals: u8,
+    pub updated_at: u64,
+    pub expires_at: u64,
+}
+fn invalid() -> AuthError {
+    AuthError::Wallet(
+        "native ETH billing quote is invalid, stale, or disagrees with the finalized oracle".into(),
+    )
+}
+fn decimal(value: &str) -> Result<u128, AuthError> {
+    if value.is_empty()
+        || value.len() > 39
+        || !value.bytes().all(|b| b.is_ascii_digit())
+        || (value.len() > 1 && value.starts_with('0'))
+    {
+        return Err(invalid());
+    }
+    value.parse().map_err(|_| invalid())
+}
+fn lowercase_address(value: &str) -> bool {
+    value.len() == 42
+        && value.starts_with("0x")
+        && value[2..]
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        && value[2..].bytes().any(|b| b != b'0')
+}
+impl Quote {
+    /// Checks that depend only on the quote and the chain it was bound to. A
+    /// saved request's quote is proof-bound: comparing it with pins changed
+    /// since (feed, decimals, maximum age) would strand its receipt.
+    pub fn validate_intrinsic(&self, chain_id: u64) -> Result<(), AuthError> {
+        let round = decimal(&self.round_id)?;
+        let answer = decimal(&self.answer)?;
+        if self.asset != "native_eth"
+            || self.units_per_eth != 1_000_000_000
+            || self.chain_id != chain_id
+            || !lowercase_address(&self.feed_address)
+            // budget_units and usd_micros assume an 8-decimal answer.
+            || self.decimals != 8
+            || round == 0
+            || round >= 1u128 << 80
+            || answer == 0
+            || answer > 1_000_000_000_000_000_000
+            || self.updated_at == 0
+            || self.expires_at <= self.updated_at
+            || self.expires_at - self.updated_at > 86400
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+    /// Whether the live native billing configuration, or its pinned feed,
+    /// decimals or maximum age, would refuse this quote, whatever the clock.
+    pub fn conflicts_with_pins(&self, config: &AuthConfig) -> bool {
+        config.billing_asset != "native_eth"
+            || config.billing_unit != "gwei"
+            || config.native_asset_wei_per_unit != "1000000000"
+            || config.demo_billing_token_address.is_some()
+            || config.native_price_feed_decimals != 8
+            || config.native_price_max_age_seconds == 0
+            || config.native_price_max_age_seconds > 86400
+            || self.feed_address != config.native_price_feed_address.to_ascii_lowercase()
+            || self.decimals != config.native_price_feed_decimals
+            || self
+                .updated_at
+                .checked_add(config.native_price_max_age_seconds)
+                != Some(self.expires_at)
+    }
+    /// New admissions only: also require the live pinned feed, decimals and
+    /// maximum age, and an unexpired quote.
+    pub fn validate(&self, config: &AuthConfig) -> Result<(), AuthError> {
+        self.validate_intrinsic(config.chain_id)?;
+        if self.conflicts_with_pins(config)
+            || self.updated_at > crate::service::now_seconds()
+            || self.expires_at <= crate::service::now_seconds()
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+    pub fn budget_units(&self, micro_usd: u128) -> Result<u128, AuthError> {
+        if ![1_000_000, 2_000_000, 3_000_000, 4_500_000, 6_000_000].contains(&micro_usd) {
+            return Err(invalid());
+        }
+        let numerator = micro_usd
+            .checked_mul(100_000_000_000_000_000u128)
+            .ok_or_else(invalid)?;
+        let denominator = decimal(&self.answer)?
+            .checked_mul(1_000_000)
+            .ok_or_else(invalid)?;
+        let units = numerator / denominator + u128::from(numerator % denominator != 0);
+        if units == 0 || units > 9_007_199_254_740_991 {
+            return Err(invalid());
+        }
+        Ok(units)
+    }
+    pub fn usd_micros(&self, units: u128) -> Result<u128, AuthError> {
+        if units == 0 || units > 9_007_199_254_740_991 {
+            return Err(invalid());
+        }
+        let value = units
+            .checked_mul(decimal(&self.answer)?)
+            .and_then(|n| n.checked_mul(1_000_000))
+            .ok_or_else(invalid)?
+            / 100_000_000_000_000_000u128;
+        if value == 0 || value > 9_007_199_254_740_991 {
+            return Err(invalid());
+        }
+        Ok(value)
+    }
+}
+async fn json_response(mut response: reqwest::Response) -> Result<Value, AuthError> {
+    if !response.status().is_success() {
+        return Err(invalid());
+    }
+    let mut body = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|_| invalid())? {
+        if body.len() + chunk.len() > 65536 {
+            return Err(invalid());
+        }
+        body.extend_from_slice(&chunk);
+    }
+    serde_json::from_slice(&body).map_err(|_| invalid())
+}
+async fn rpc(config: &AuthConfig, method: &str, params: Value) -> Result<Value, AuthError> {
+    let url = config.demo_rpc_url.as_ref().ok_or_else(invalid)?;
+    let body = json_response(
+        crate::service::fresh_private_http()?
+            .post(url)
+            .timeout(std::time::Duration::from_secs(20))
+            .json(&json!({"jsonrpc":"2.0","id":1,"method":method,"params":params}))
+            .send()
+            .await
+            .map_err(|_| invalid())?,
+    )
+    .await?;
+    if body["jsonrpc"] != "2.0" || body["id"] != 1 || body.get("error").is_some() {
+        return Err(invalid());
+    }
+    body.get("result").cloned().ok_or_else(invalid)
+}
+fn hex_u128(value: &Value) -> Result<u128, AuthError> {
+    let text = value
+        .as_str()
+        .and_then(|v| v.strip_prefix("0x"))
+        .ok_or_else(invalid)?;
+    if text.is_empty() || !text.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err(invalid());
+    }
+    u128::from_str_radix(text.trim_start_matches('0').trim(), 16)
+        .or_else(|_| {
+            if text.bytes().all(|b| b == b'0') {
+                Ok(0)
+            } else {
+                Err(())
+            }
+        })
+        .map_err(|_| invalid())
+}
+fn block_identity(block: &Value) -> Result<(&str, &str), AuthError> {
+    let number = block["number"].as_str().ok_or_else(invalid)?;
+    hex_u128(&block["number"])?;
+    let hash = block["hash"].as_str().ok_or_else(invalid)?;
+    if !hash.starts_with("0x")
+        || hash.len() != 66
+        || !hash[2..].bytes().all(|b| b.is_ascii_hexdigit())
+    {
+        return Err(invalid());
+    }
+    Ok((number, hash))
+}
+pub(crate) async fn verified_quote(config: &AuthConfig) -> Result<Quote, AuthError> {
+    let response = zkapi_client::testnet_auth::request(config.chain_id, &config.protocol_server_url, reqwest::Method::GET, format!(
+                "{}/v2/billing/quote",
+                config.protocol_server_url.trim_end_matches('/')
+            ))?
+            .timeout(std::time::Duration::from_secs(20))
+            .send()
+            .await
+            .map_err(|_| invalid())?;
+    let proposed = json_response(zkapi_client::testnet_auth::check_response(response)?).await?;
+    let quote: Quote = serde_json::from_value(proposed).map_err(|_| invalid())?;
+    quote.validate(config)?;
+    if hex_u128(&rpc(config, "eth_chainId", json!([])).await?)? != config.chain_id as u128 {
+        return Err(invalid());
+    }
+    let block = rpc(config, "eth_getBlockByNumber", json!(["finalized", false])).await?;
+    let (number, hash) = block_identity(&block)?;
+    let vault = format!(
+        "0x{}",
+        config.contract_address.as_bytes()[12..]
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect::<String>()
+    );
+    for (data, expected) in [("0x4d1352fd", 1_000_000_000u128), ("0x631b2f10", 0)] {
+        let result = rpc(
+            config,
+            "eth_call",
+            json!([{"to":vault,"data":data},"latest"]),
+        )
+        .await?;
+        if result.as_str().is_none_or(|s| s.len() != 66) || hex_u128(&result)? != expected {
+            return Err(invalid());
+        }
+    }
+    let decimals = rpc(
+        config,
+        "eth_call",
+        json!([{"to":config.native_price_feed_address,"data":"0x313ce567"},number]),
+    )
+    .await?;
+    if hex_u128(&decimals)? != quote.decimals as u128 {
+        return Err(invalid());
+    }
+    let encoded = rpc(
+        config,
+        "eth_call",
+        json!([{"to":config.native_price_feed_address,"data":"0xfeaf968c"},number]),
+    )
+    .await?;
+    let encoded = encoded.as_str().ok_or_else(invalid)?;
+    if encoded.len() != 322
+        || !encoded.starts_with("0x")
+        || !encoded[2..].bytes().all(|b| b.is_ascii_hexdigit())
+    {
+        return Err(invalid());
+    }
+    let words = (0..5)
+        .map(|i| {
+            hex_u128(&json!(format!(
+                "0x{}",
+                &encoded[2 + i * 64..2 + (i + 1) * 64]
+            )))
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    if words[0] != decimal(&quote.round_id)?
+        || words[1] != decimal(&quote.answer)?
+        || words[2] == 0
+        || words[2] > words[3]
+        || words[3] != quote.updated_at as u128
+        || words[4] < words[0]
+    {
+        return Err(invalid());
+    }
+    let canonical = rpc(config, "eth_getBlockByNumber", json!([number, false])).await?;
+    let (_, canonical_hash) = block_identity(&canonical)?;
+    if !canonical_hash.eq_ignore_ascii_case(hash)
+        || hex_u128(&rpc(config, "eth_chainId", json!([])).await?)? != config.chain_id as u128
+    {
+        return Err(invalid());
+    }
+    Ok(quote)
+}
+pub(crate) fn saved_quote(config: &AuthConfig, payload: &str) -> Result<Option<Quote>, AuthError> {
+    let mut value: Value = serde_json::from_str(payload).map_err(|_| invalid())?;
+    let object = value.as_object_mut().ok_or_else(invalid)?;
+    let quote = object
+        .remove("billing_quote")
+        .map(serde_json::from_value::<Quote>)
+        .transpose()
+        .map_err(|_| invalid())?;
+    let authorization: zkapi_types::wire::OpenRouterLeaseAuthorization =
+        serde_json::from_value(value).map_err(|_| invalid())?;
+    if authorization != Default::default() {
+        return Err(invalid());
+    }
+    match (&*config.billing_asset, &quote) {
+        ("native_eth", Some(quote)) => quote.validate_intrinsic(config.chain_id)?,
+        ("native_eth", None) => return Err(invalid()),
+        (_, Some(_)) => return Err(invalid()),
+        _ => {}
+    }
+    Ok(quote)
+}
+/// A saved native request quoted under pins that have changed since, whose
+/// quote has expired by the local clock. The server checks a new admission's
+/// pins before its freshness, so it refuses such a request with
+/// invalid_request rather than native_quote_expired. Only the server's expiry
+/// acknowledgement may retire it.
+pub(crate) fn expired_under_earlier_pins(config: &AuthConfig, payload: &str) -> bool {
+    matches!(saved_quote(config, payload), Ok(Some(quote))
+        if quote.conflicts_with_pins(config)
+            && quote.expires_at <= crate::service::now_seconds())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn fixture() -> (AuthConfig, Quote) {
+        let config = AuthConfig {
+            billing_asset: "native_eth".into(),
+            billing_unit: "gwei".into(),
+            native_asset_wei_per_unit: "1000000000".into(),
+            native_price_feed_address: format!("0x{}", "12".repeat(20)),
+            native_price_feed_decimals: 8,
+            native_price_max_age_seconds: 3600,
+            ..Default::default()
+        };
+        let updated = crate::service::now_seconds() - 60;
+        let quote = Quote {
+            asset: "native_eth".into(),
+            units_per_eth: 1_000_000_000,
+            chain_id: config.chain_id,
+            feed_address: config.native_price_feed_address.clone(),
+            round_id: "123".into(),
+            answer: "250000000000".into(),
+            decimals: 8,
+            updated_at: updated,
+            expires_at: updated + 3600,
+        };
+        (config, quote)
+    }
+    /// Each native-price pin a release may change, one at a time.
+    fn later_pins(config: &AuthConfig) -> [(&'static str, AuthConfig); 3] {
+        let mut feed = config.clone();
+        feed.native_price_feed_address = format!("0x{}", "34".repeat(20));
+        let mut max_age = config.clone();
+        max_age.native_price_max_age_seconds = 4500;
+        let mut decimals = config.clone();
+        decimals.native_price_feed_decimals = 18;
+        [
+            ("feed address", feed),
+            ("maximum age", max_age),
+            ("feed decimals", decimals),
+        ]
+    }
+    #[test]
+    fn native_budget_and_saved_quote_bindings_are_exact() {
+        let (config, quote) = fixture();
+        quote.validate(&config).unwrap();
+        assert_eq!(quote.budget_units(1_000_000).unwrap(), 400_000);
+        assert_eq!(quote.usd_micros(400_000).unwrap(), 1_000_000);
+        assert!(quote.budget_units(7_000_000).is_err());
+        let mut changed = quote.clone();
+        changed.answer = "300000000001".into();
+        assert_eq!(changed.budget_units(1_000_000).unwrap(), 333_334);
+        let payload =
+            json!({"mode":"openrouter_ephemeral_lease","version":1,"billing_quote":quote})
+                .to_string();
+        assert_eq!(saved_quote(&config, &payload).unwrap(), Some(quote.clone()));
+        assert!(saved_quote(
+            &config,
+            r#"{"mode":"openrouter_ephemeral_lease","version":1}"#
+        )
+        .is_err());
+        for (field, value) in [
+            ("chain_id", json!(111)),
+            ("feed_address", json!(format!("0x{}", "34".repeat(20)))),
+            ("answer", json!("0")),
+            ("round_id", json!("0123")),
+            ("units_per_eth", json!(1)),
+            ("expires_at", json!(0)),
+            // Intrinsically valid, but not the pinned 3600 s maximum age.
+            ("expires_at", json!(quote.updated_at + 4500)),
+        ] {
+            let mut value_quote = serde_json::to_value(&quote).unwrap();
+            value_quote[field] = value;
+            assert!(serde_json::from_value::<Quote>(value_quote)
+                .unwrap()
+                .validate(&config)
+                .is_err());
+        }
+        let mut expired = quote.clone();
+        expired.updated_at = 1;
+        expired.expires_at = 3601;
+        assert!(expired.validate(&config).is_err());
+        expired.validate_intrinsic(config.chain_id).unwrap();
+        // A round stamped in the future is refused, even with the pinned span.
+        let mut future = quote.clone();
+        future.updated_at = crate::service::now_seconds() + 600;
+        future.expires_at = future.updated_at + 3600;
+        future.validate_intrinsic(config.chain_id).unwrap();
+        assert!(!future.conflicts_with_pins(&config));
+        assert!(future.validate(&config).is_err());
+    }
+    #[test]
+    fn saved_quote_is_checked_intrinsically_not_against_later_pins() {
+        let (config, quote) = fixture();
+        let payload =
+            json!({"mode":"openrouter_ephemeral_lease","version":1,"billing_quote":quote})
+                .to_string();
+        // A feed migration, a new maximum age or new feed decimals applies to
+        // new admissions only. Each pin alone refuses admission.
+        for (pin, later) in later_pins(&config) {
+            assert!(quote.conflicts_with_pins(&later), "{pin}");
+            assert!(quote.validate(&later).is_err(), "{pin}");
+            assert_eq!(
+                saved_quote(&later, &payload).unwrap(),
+                Some(quote.clone()),
+                "{pin}"
+            );
+        }
+        assert!(!quote.conflicts_with_pins(&config));
+        let feed = |byte: &str| format!("0x{}", byte.repeat(20));
+        let mut other_chain = config.clone();
+        other_chain.chain_id = 111;
+        assert!(saved_quote(&other_chain, &payload).is_err());
+        for (field, value, valid) in [
+            ("feed_address", json!(feed("34")), true),
+            ("expires_at", json!(quote.updated_at + 4500), true),
+            ("chain_id", json!(111), false),
+            ("feed_address", json!(feed("AB")), false),
+            ("feed_address", json!(feed("00")), false),
+            ("feed_address", json!("0x1234"), false),
+            ("decimals", json!(18), false),
+            ("answer", json!("0"), false),
+            ("round_id", json!("0123"), false),
+            ("units_per_eth", json!(1), false),
+            ("updated_at", json!(0), false),
+            ("expires_at", json!(quote.updated_at), false),
+            ("expires_at", json!(quote.updated_at + 86_401), false),
+        ] {
+            let mut value_quote = serde_json::to_value(&quote).unwrap();
+            value_quote[field] = value.clone();
+            let changed: Quote = serde_json::from_value(value_quote).unwrap();
+            assert_eq!(
+                changed.validate_intrinsic(config.chain_id).is_ok(),
+                valid,
+                "{field} {value}"
+            );
+        }
+    }
+    #[test]
+    fn only_an_expired_quote_under_changed_pins_asks_the_server_to_expire_it() {
+        let (config, quote) = fixture();
+        let payload = |quote: &Quote| {
+            json!({"mode":"openrouter_ephemeral_lease","version":1,"billing_quote":quote})
+                .to_string()
+        };
+        let mut expired = quote.clone();
+        expired.updated_at = 1;
+        expired.expires_at = 3601;
+        // Under unchanged pins the server itself answers native_quote_expired.
+        assert!(!expired_under_earlier_pins(&config, &payload(&expired)));
+        for (pin, later) in later_pins(&config) {
+            assert!(
+                expired_under_earlier_pins(&later, &payload(&expired)),
+                "{pin}"
+            );
+            // Before expiry the server cannot confirm it was never admitted.
+            assert!(
+                !expired_under_earlier_pins(&later, &payload(&quote)),
+                "{pin}"
+            );
+        }
+        // Only a valid saved native quote for this chain qualifies.
+        let [(_, mut later), ..] = later_pins(&config);
+        let no_quote = r#"{"mode":"openrouter_ephemeral_lease","version":1}"#;
+        assert!(!expired_under_earlier_pins(&later, no_quote));
+        later.chain_id = 111;
+        assert!(!expired_under_earlier_pins(&later, &payload(&expired)));
+    }
+    #[tokio::test]
+    async fn oracle_requires_finalized_round_chain_vault_and_canonical_block() {
+        use axum::{
+            routing::{get, post},
+            Json, Router,
+        };
+        use std::sync::{
+            atomic::{AtomicU8, Ordering},
+            Arc,
+        };
+        let (mut config, quote) = fixture();
+        let mode = Arc::new(AtomicU8::new(0));
+        let quote_response = quote.clone();
+        let rpc_quote = quote.clone();
+        let modes = mode.clone();
+        let router=Router::new().route("/v2/billing/quote",get(move||{let q=quote_response.clone();async move {Json(json!(q))}}))
+            .route("/rpc",post(move|Json(body):Json<Value>|{let q=rpc_quote.clone();let mode=modes.load(Ordering::SeqCst);async move {
+                let result=match body["method"].as_str().unwrap() {
+                    "eth_chainId"=>json!(if mode==1{"0x2"}else{"0x1"}),
+                    "eth_getBlockByNumber"=>json!({"number":"0x10","hash":format!("0x{}",if mode==2 && body["params"][0]=="0x10"{"bb".repeat(32)}else{"aa".repeat(32)})}),
+                    "eth_call"=>match body["params"][0]["data"].as_str().unwrap() {
+                        "0x4d1352fd"=>json!(format!("0x{:064x}",if mode==3{0}else{1_000_000_000u128})),
+                        "0x631b2f10"=>json!(format!("0x{:064x}",if mode==4{1}else{0})),
+                        "0x313ce567"=>json!(format!("0x{:064x}",if mode==5{9}else{8})),
+                        "0xfeaf968c"=>json!(format!("0x{:064x}{:064x}{:064x}{:064x}{:064x}",if mode==6{124}else{123},250_000_000_000u128,q.updated_at-1,q.updated_at,123)),_=>panic!("unexpected call")},_=>panic!("unexpected method")};
+                Json(json!({"jsonrpc":"2.0","id":1,"result":result}))
+            }}));
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!("http://{}", listener.local_addr().unwrap());
+        config.protocol_server_url = url.clone();
+        config.demo_rpc_url = Some(format!("{url}/rpc"));
+        let server = tokio::spawn(async move { axum::serve(listener, router).await.unwrap() });
+        assert_eq!(verified_quote(&config).await.unwrap(), quote);
+        for value in 1..=6 {
+            mode.store(value, Ordering::SeqCst);
+            assert!(verified_quote(&config).await.is_err(), "mode {value}");
+        }
+        server.abort();
+    }
+}
diff --git a/crates/zkapi-clientd/src/oa_station_trust.rs b/crates/zkapi-clientd/src/oa_station_trust.rs
new file mode 100644
index 0000000..1756288
--- /dev/null
+++ b/crates/zkapi-clientd/src/oa_station_trust.rs
@@ -0,0 +1,60 @@
+//! Operator-pinned exception for using an explicitly unverified provider key.
+//! Registry flags and names alone never authenticate a station-issued key.
+
+#[derive(Clone, Copy)]
+pub(crate) struct StationTrust<'a> {
+    pub station_id: &'a str,
+    pub public_key_hex: &'a str,
+    pub verifier_url: &'a str,
+}
+
+pub(crate) const TRUSTED_STATION: StationTrust<'static> = StationTrust {
+    station_id: "oa-station",
+    public_key_hex: "20019ebb3cfa61a34ac75879bca8ccf9168ce435c6007d5279b84ebeb83fd097",
+    verifier_url: "https://verifier2.openanonymity.ai",
+};
+
+fn hex_bytes(text: &str, size: usize) -> Option<Vec<u8>> {
+    if text.len() != size * 2 || !text.bytes().all(|b| b.is_ascii_hexdigit()) { return None; }
+    text.as_bytes().chunks_exact(2).map(|pair| {
+        let pair = std::str::from_utf8(pair).ok()?;
+        u8::from_str_radix(pair, 16).ok()
+    }).collect()
+}
+
+impl StationTrust<'_> {
+    pub fn authenticates(&self, configured_verifier: &str, evidence_verifier: &str,
+        station_id: &str, api_key: &str, key_valid_till: u64, station_signature: &str) -> bool {
+        if configured_verifier.trim_end_matches('/') != self.verifier_url
+            || evidence_verifier.trim_end_matches('/') != self.verifier_url
+            || station_id != self.station_id || api_key.is_empty() || key_valid_till == 0 { return false; }
+        let (Some(public_key), Some(signature)) = (hex_bytes(self.public_key_hex, 32), hex_bytes(station_signature, 64)) else { return false; };
+        let message = format!("{station_id}|{api_key}|{key_valid_till}");
+        ring::signature::UnparsedPublicKey::new(&ring::signature::ED25519, public_key)
+            .verify(message.as_bytes(), &signature).is_ok()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use ring::signature::{Ed25519KeyPair, KeyPair};
+    #[test]
+    fn signature_authenticates_only_pinned_station_key_expiry_and_origin() {
+        let pair = Ed25519KeyPair::from_seed_unchecked(&[7; 32]).unwrap();
+        let public = pair.public_key().as_ref().iter().map(|b| format!("{b:02x}")).collect::<String>();
+        let signature = pair.sign(b"oa-station|test-child-key|2000000000").as_ref().iter().map(|b| format!("{b:02x}")).collect::<String>();
+        let trust = StationTrust { public_key_hex: &public, ..TRUSTED_STATION };
+        let url = TRUSTED_STATION.verifier_url;
+        assert!(trust.authenticates(url, url, "oa-station", "test-child-key", 2_000_000_000, &signature));
+        for (configured,evidence,station,key,expiry,sig) in [
+            (url,url,"unknown","test-child-key",2_000_000_000,signature.as_str()),
+            (url,url,"oa-station","swapped-key",2_000_000_000,signature.as_str()),
+            (url,url,"oa-station","test-child-key",2_000_000_001,signature.as_str()),
+            ("https://other.example",url,"oa-station","test-child-key",2_000_000_000,signature.as_str()),
+            (url,"https://other.example","oa-station","test-child-key",2_000_000_000,signature.as_str()),
+            (url,url,"oa-station","test-child-key",2_000_000_000,"not-hex")
+        ] { assert!(!trust.authenticates(configured,evidence,station,key,expiry,sig)); }
+        assert!(!TRUSTED_STATION.authenticates(url,url,"oa-station","test-child-key",2_000_000_000,&signature));
+    }
+}
diff --git a/crates/zkapi-clientd/src/oa_withdrawal.rs b/crates/zkapi-clientd/src/oa_withdrawal.rs
new file mode 100644
index 0000000..8d48d40
--- /dev/null
+++ b/crates/zkapi-clientd/src/oa_withdrawal.rs
@@ -0,0 +1,1358 @@
+//! Durable OA withdrawal reservation. Every call runs under the wallet lock.
+//! The snapshot is local recovery material and is never returned over HTTP.
+use std::fs::{self, File, OpenOptions};
+use std::io::Write;
+use std::path::Path;
+use std::time::Duration;
+
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use sha3::{Digest, Keccak256};
+use zkapi_client::note_state::NoteState;
+use zkapi_core::v2;
+use zkapi_types::Felt252;
+
+use crate::config::AuthConfig;
+use crate::error::AuthError;
+use crate::indexer::IndexerClient;
+use crate::service::{WithdrawalMode, WithdrawalPlan};
+
+const FILE: &str = "oa-withdrawal.json";
+
+#[derive(Clone, Serialize, Deserialize)]
+pub(crate) struct Reservation {
+    version: u8,
+    pub snapshot: NoteState,
+    pub destination: [u8; 20],
+    pub nullifier: Felt252,
+    pub plan: Option<WithdrawalPlan>,
+    pub complete: bool,
+    pub transaction_hash: Option<String>,
+    /// The owner acknowledged sending an ownership proof from this expired
+    /// note's unsettled state (see `AuthService::oa_prepare_withdrawal`).
+    /// Every later clearance request for this reservation carries the proof.
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub unsettled_request_risk_accepted: bool,
+    /// Whether a clearance request carrying this state's ownership proof may
+    /// have left the companion. It is saved as `true` once the proof is built
+    /// and before the request is sent, whatever answer (a gateway 429, a 5xx,
+    /// none) follows: whoever saw the request may hold the proof, which is a
+    /// submittable escape at this nullifier. `None` in a reservation saved
+    /// before this field existed; see `ownership_proof_may_have_left`.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub ownership_proof_sent: Option<bool>,
+    /// The confirmed payout is a finalized escape that the vault could not
+    /// push to the destination: it credited the balance to
+    /// `escapePayoutCredits(destination)` (`EscapePayoutDeferred`), and only
+    /// `claimEscapePayout(destination)` delivers it.
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub escape_payout_credited: bool,
+}
+
+impl Reservation {
+    /// Whether this reservation's ownership proof may have left the
+    /// companion. A reservation saved before `ownership_proof_sent` existed
+    /// does not say. No tagged release sent one: up to `zkapi-clientd` 0.1.6
+    /// a clearance request carried only the nullifier. Development builds
+    /// between that release and this field sent one with every clearance
+    /// request, the later ones except from a state with an unsettled request
+    /// (`unsettled_state`) whose risk the owner never acknowledged; such a
+    /// reservation keeps its state, so that state's request archive is
+    /// unchanged since. No build could send a proof it could not build, and
+    /// building one needs the reserved state's note leaf in the vault's tree
+    /// at its note id (`leaf_in_tree`, asked only for such a reservation).
+    /// A wrongly bound note, the case release exists for, fails that, so its
+    /// reservation releases whichever build saved it.
+    pub(crate) fn ownership_proof_may_have_left(
+        &self,
+        unsettled_state: bool,
+        leaf_in_tree: impl FnOnce() -> Result<bool, AuthError>,
+    ) -> Result<bool, AuthError> {
+        match self.ownership_proof_sent {
+            Some(sent) => Ok(sent),
+            None if unsettled_state && !self.unsettled_request_risk_accepted => Ok(false),
+            None => leaf_in_tree(),
+        }
+    }
+}
+
+/// Whether `state`'s note leaf is in the vault's tree at its note id, as the
+/// indexer reports it. Every withdrawal or request proof from the state
+/// proves exactly that membership: without it no ownership proof was ever
+/// built from the state, and no request proof can be built from it either.
+pub(crate) async fn note_leaf_in_tree(
+    indexer: &IndexerClient,
+    state: &NoteState,
+) -> Result<bool, AuthError> {
+    let leaf = v2::note_leaf(
+        state.note_id,
+        &v2::registration_commitment(&state.secret_s),
+        state.deposit_amount,
+        state.expiry_ts,
+    );
+    Ok(indexer.note_leaf(state.note_id).await? == leaf)
+}
+
+/// Recorded, before the request leaves, that a clearance request carrying
+/// this reservation's ownership proof is about to be sent. On a vault below
+/// revision 2 the reservation then stays until the note closes: it is never
+/// released, so no request proof is made at its nullifier.
+pub(crate) fn record_ownership_proof_sent(
+    config: &AuthConfig,
+    record: &mut Reservation,
+) -> Result<(), AuthError> {
+    if record.ownership_proof_sent != Some(true) {
+        record.ownership_proof_sent = Some(true);
+        save(config, record)?;
+    }
+    Ok(())
+}
+
+fn storage_error() -> AuthError {
+    AuthError::Wallet(
+        "withdrawal recovery storage is unavailable or invalid; preserve its files".into(),
+    )
+}
+
+pub(crate) fn destination(value: &str) -> Result<[u8; 20], AuthError> {
+    let bytes = hex_bytes(value, 20)?;
+    let mut result = [0; 20];
+    result.copy_from_slice(&bytes);
+    if result == [0; 20] {
+        return Err(AuthError::InvalidInput(
+            "withdrawal destination cannot be the zero address".into(),
+        ));
+    }
+    Ok(result)
+}
+
+/// A withdrawal destination the vault can pay: neither the zero address nor
+/// the vault itself. A vault with `vault_revision` 2 refuses its own address
+/// (`InvalidDestination`), and a legacy vault cannot receive the payout, so
+/// every close to it reverts. Checked before any note is reserved or any
+/// clearance is requested: a clearance is permanent, and the reservation
+/// pins its destination.
+pub(crate) fn check_destination(config: &AuthConfig, destination: &[u8; 20]) -> Result<(), AuthError> {
+    if *destination == [0; 20] {
+        return Err(AuthError::InvalidInput(
+            "withdrawal destination cannot be the zero address".into(),
+        ));
+    }
+    if zkapi_types::serialization::address_to_felt(destination) == config.contract_address {
+        return Err(AuthError::InvalidInput(
+            "withdrawal destination cannot be the vault contract, which cannot pay itself".into(),
+        ));
+    }
+    Ok(())
+}
+
+fn hex_bytes(value: &str, size: usize) -> Result<Vec<u8>, AuthError> {
+    if !value.starts_with("0x")
+        || value.len() != 2 + size * 2
+        || !value[2..].bytes().all(|b| b.is_ascii_hexdigit())
+    {
+        return Err(AuthError::InvalidInput(
+            "invalid withdrawal hexadecimal value".into(),
+        ));
+    }
+    (2..value.len())
+        .step_by(2)
+        .map(|i| {
+            u8::from_str_radix(&value[i..i + 2], 16)
+                .map_err(|_| AuthError::InvalidInput("invalid withdrawal hexadecimal value".into()))
+        })
+        .collect()
+}
+
+fn hex(value: &[u8]) -> String {
+    format!(
+        "0x{}",
+        value.iter().map(|b| format!("{b:02x}")).collect::<String>()
+    )
+}
+
+fn same_state(left: &NoteState, right: &NoteState) -> bool {
+    matches!((serde_json::to_value(left), serde_json::to_value(right)), (Ok(left), Ok(right)) if left == right)
+}
+
+pub(crate) fn load(config: &AuthConfig) -> Result<Option<Reservation>, AuthError> {
+    let path = config.state_dir.join(FILE);
+    let metadata = match fs::symlink_metadata(&path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(_) => return Err(storage_error()),
+    };
+    if !metadata.is_file() || metadata.len() > 1 << 20 {
+        return Err(storage_error());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        if metadata.permissions().mode() & 0o777 != 0o600 {
+            return Err(storage_error());
+        }
+    }
+    let record: Reservation = serde_json::from_slice(&fs::read(path).map_err(|_| storage_error())?)
+        .map_err(|_| storage_error())?;
+    if record.version != 1
+        || record.snapshot.protocol_version != config.protocol_version
+        || record.snapshot.chain_id != config.chain_id
+        || record.snapshot.contract_address != config.contract_address
+        || record.destination == [0; 20]
+        || record.nullifier
+            != v2::nullifier(&record.snapshot.secret_s, &record.snapshot.current_anchor)
+        || (record.complete && record.transaction_hash.is_none())
+    {
+        return Err(storage_error());
+    }
+    if let Some(plan) = &record.plan {
+        validate_plan(&record, plan)?;
+    }
+    if let Some(hash) = &record.transaction_hash {
+        hex_bytes(hash, 32)?;
+    }
+    Ok(Some(record))
+}
+
+pub(crate) fn reserve(
+    config: &AuthConfig,
+    state: &NoteState,
+    destination: [u8; 20],
+) -> Result<Reservation, AuthError> {
+    if state.protocol_version != config.protocol_version
+        || state.chain_id != config.chain_id
+        || state.contract_address != config.contract_address
+        || destination == [0; 20]
+    {
+        return Err(AuthError::WithdrawalConflict);
+    }
+    if let Some(previous) = load(config)? {
+        if previous.complete && previous.snapshot.note_id != state.note_id {
+            archive(
+                config,
+                &previous,
+                "reservation",
+                &serde_json::to_vec(&previous).map_err(|_| storage_error())?,
+            )?;
+        } else {
+            if previous.destination != destination || !same_state(&previous.snapshot, state) {
+                return Err(AuthError::WithdrawalConflict);
+            }
+            return Ok(previous);
+        }
+    }
+    let record = Reservation {
+        version: 1,
+        snapshot: state.clone(),
+        destination,
+        nullifier: v2::nullifier(&state.secret_s, &state.current_anchor),
+        plan: None,
+        complete: false,
+        transaction_hash: None,
+        unsettled_request_risk_accepted: false,
+        ownership_proof_sent: Some(false),
+        escape_payout_credited: false,
+    };
+    save(config, &record)?;
+    Ok(record)
+}
+
+pub(crate) fn save(config: &AuthConfig, record: &Reservation) -> Result<(), AuthError> {
+    atomic_write(
+        &config.state_dir.join(FILE),
+        &serde_json::to_vec(record).map_err(|_| storage_error())?,
+    )
+}
+
+/// The generic `/wallet/withdraw` mutual close has no reservation. On a vault
+/// below revision 2 it records here, before a clearance request carrying an
+/// ownership proof leaves, the state that proof was made at; no request proof
+/// is made at that state's nullifier afterwards (`check_request_state`).
+const OWNERSHIP_PROOF_MARKER: &str = "oa-ownership-proof-sent.json";
+
+#[derive(Serialize, Deserialize)]
+struct OwnershipProofMarker {
+    version: u8,
+    note_id: u32,
+    nullifier: Felt252,
+}
+
+pub(crate) fn record_ownership_proof_marker(
+    config: &AuthConfig,
+    state: &NoteState,
+) -> Result<(), AuthError> {
+    if config.vault_revision >= 2 {
+        return Ok(());
+    }
+    let marker = OwnershipProofMarker {
+        version: 1,
+        note_id: state.note_id,
+        nullifier: v2::nullifier(&state.secret_s, &state.current_anchor),
+    };
+    atomic_write(
+        &config.state_dir.join(OWNERSHIP_PROOF_MARKER),
+        &serde_json::to_vec(&marker).map_err(|_| storage_error())?,
+    )
+}
+
+/// Refuse a new request proof from `state` when a clearance request carrying
+/// its ownership proof may have left the companion: whoever saw that request
+/// could escape with the proof and challenge the escape with the request,
+/// which burns the nullifier on a vault below revision 2. The note stays
+/// withdrawal-only; closing again or escaping still works.
+pub(crate) fn check_request_state(config: &AuthConfig, state: &NoteState) -> Result<(), AuthError> {
+    let path = config.state_dir.join(OWNERSHIP_PROOF_MARKER);
+    let bytes = match fs::read(&path) {
+        Ok(bytes) => bytes,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()),
+        Err(_) => return Err(storage_error()),
+    };
+    let marker: OwnershipProofMarker =
+        serde_json::from_slice(&bytes).map_err(|_| storage_error())?;
+    if marker.version != 1 {
+        return Err(storage_error());
+    }
+    if marker.note_id == state.note_id
+        && marker.nullifier == v2::nullifier(&state.secret_s, &state.current_anchor)
+    {
+        return Err(AuthError::OwnershipProofSent);
+    }
+    Ok(())
+}
+
+pub(crate) fn check_spending(config: &AuthConfig, note_id: Option<u32>) -> Result<(), AuthError> {
+    if let Some(record) = load(config)? {
+        if !record.complete || note_id == Some(record.snapshot.note_id) {
+            return Err(AuthError::WithdrawalConflict);
+        }
+    }
+    Ok(())
+}
+
+pub(crate) fn validate_plan(record: &Reservation, plan: &WithdrawalPlan) -> Result<(), AuthError> {
+    let inputs = &plan.public_inputs;
+    if plan.mode != WithdrawalMode::Mutual
+        || !inputs.has_clearance
+        || inputs.protocol_version != record.snapshot.protocol_version
+        || inputs.chain_id != record.snapshot.chain_id
+        || inputs.contract_address != record.snapshot.contract_address
+        || inputs.note_id != record.snapshot.note_id
+        || inputs.final_balance != record.snapshot.current_balance
+        || inputs.destination != record.destination
+        || inputs.withdrawal_nullifier != record.nullifier
+        || plan.siblings.len() != 32
+        || inputs.withdrawal_tag
+            != v2::withdrawal_tag(
+                &record.nullifier,
+                &inputs.destination_field(),
+                inputs.final_balance,
+                true,
+            )
+    {
+        return Err(AuthError::WithdrawalConflict);
+    }
+    Ok(())
+}
+
+pub(crate) fn public_status(record: Option<&Reservation>) -> Value {
+    match record {
+        None => json!({"phase": "none"}),
+        Some(record) => {
+            let mut status = json!({"phase": if record.complete {"complete"} else {"reserved"},
+                "note_id": record.snapshot.note_id, "destination": hex(&record.destination),
+                "final_balance": record.snapshot.current_balance.to_string(), "withdrawal_nullifier": hex(record.nullifier.as_bytes())});
+            if let Some(hash) = &record.transaction_hash {
+                status["transaction_hash"] = json!(hash);
+            }
+            if record.escape_payout_credited {
+                status["escape_payout_credited"] = json!(true);
+            }
+            status
+        }
+    }
+}
+
+fn atomic_write(path: &Path, bytes: &[u8]) -> Result<(), AuthError> {
+    #[cfg(unix)]
+    use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
+    let temporary = path.with_extension("tmp");
+    let mut options = OpenOptions::new();
+    options.write(true).create(true).truncate(true);
+    #[cfg(unix)]
+    options.mode(0o600);
+    let mut file = options.open(&temporary).map_err(|_| storage_error())?;
+    #[cfg(unix)]
+    file.set_permissions(fs::Permissions::from_mode(0o600))
+        .map_err(|_| storage_error())?;
+    file.write_all(bytes)
+        .and_then(|_| file.sync_all())
+        .map_err(|_| storage_error())?;
+    fs::rename(&temporary, path).map_err(|_| storage_error())?;
+    File::open(path.parent().ok_or_else(storage_error)?)
+        .and_then(|f| f.sync_all())
+        .map_err(|_| storage_error())
+}
+
+fn archive(
+    config: &AuthConfig,
+    record: &Reservation,
+    label: &str,
+    bytes: &[u8],
+) -> Result<(), AuthError> {
+    let directory = config.state_dir.join("archive");
+    fs::create_dir_all(&directory).map_err(|_| storage_error())?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        fs::set_permissions(&directory, fs::Permissions::from_mode(0o700))
+            .map_err(|_| storage_error())?;
+    }
+    File::open(&config.state_dir)
+        .and_then(|f| f.sync_all())
+        .map_err(|_| storage_error())?;
+    atomic_write(
+        &directory.join(format!(
+            "oa-withdrawal-{}-{}-{label}.json",
+            record.snapshot.note_id,
+            record.nullifier.to_hex()
+        )),
+        bytes,
+    )
+}
+
+/// Only an incomplete reservation without a plan, for the unchanged active
+/// note, may be released: it never produced a mutual-close proof. On a vault
+/// below revision 2 it also must not have sent an ownership proof: whoever
+/// saw that request (the server, or a gateway that answered it) may hold a
+/// submittable escape at this nullifier, and a request proof from the same
+/// state would let them escape and challenge, which burns the nullifier
+/// there. The server's answer that it knows nothing of the nullifier is
+/// unsigned, so no reading lifts this. `unsettled_state` is
+/// `unsettled_legacy_state` for the active note, and `leaf_in_tree` is
+/// `note_leaf_in_tree` for it (see
+/// `Reservation::ownership_proof_may_have_left`).
+pub(crate) fn check_release(
+    config: &AuthConfig,
+    record: &Reservation,
+    active: &NoteState,
+    unsettled_state: bool,
+    leaf_in_tree: impl FnOnce() -> Result<bool, AuthError>,
+) -> Result<(), AuthError> {
+    if record.complete || record.plan.is_some() || !same_state(active, &record.snapshot) {
+        return Err(AuthError::WithdrawalConflict);
+    }
+    if config.vault_revision < 2
+        && record.ownership_proof_may_have_left(unsettled_state, leaf_in_tree)?
+    {
+        return Err(AuthError::OwnershipProofSent);
+    }
+    Ok(())
+}
+
+/// Remove such a reservation, keeping an archived copy. Call under the wallet
+/// lock, only after the server reported the nullifier unknown, so that no
+/// clearance or mutual close can exist for it.
+pub(crate) fn release(
+    config: &AuthConfig,
+    record: &Reservation,
+    active: &NoteState,
+    unsettled_state: bool,
+    leaf_in_tree: impl FnOnce() -> Result<bool, AuthError>,
+) -> Result<(), AuthError> {
+    check_release(config, record, active, unsettled_state, leaf_in_tree)?;
+    archive(
+        config,
+        record,
+        "released",
+        &serde_json::to_vec(record).map_err(|_| storage_error())?,
+    )?;
+    match fs::remove_file(config.state_dir.join(FILE)) {
+        Ok(()) => {}
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+        Err(_) => return Err(storage_error()),
+    }
+    File::open(&config.state_dir)
+        .and_then(|f| f.sync_all())
+        .map_err(|_| storage_error())
+}
+
+// Called only after independently checking canonical finalized payout evidence.
+pub(crate) fn complete(
+    config: &AuthConfig,
+    record: &mut Reservation,
+    hash: &str,
+) -> Result<(), AuthError> {
+    let active_path = config.state_dir.join("note_state.json");
+    if active_path.exists() {
+        let active = NoteState::load(&active_path).map_err(|_| storage_error())?;
+        if !same_state(&active, &record.snapshot) {
+            return Err(AuthError::WithdrawalConflict);
+        }
+    }
+    if zkapi_client::journal::PendingRequestJournal::read(
+        &config.state_dir.join("pending_journal.json"),
+    )?
+    .is_some()
+    {
+        return Err(AuthError::PendingSettlement);
+    }
+    archive(
+        config,
+        record,
+        "note",
+        &serde_json::to_vec(&record.snapshot).map_err(|_| storage_error())?,
+    )?;
+    record.transaction_hash = Some(hash.to_lowercase());
+    save(config, record)?;
+    match fs::remove_file(&active_path) {
+        Ok(()) => {}
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+        Err(_) => return Err(storage_error()),
+    }
+    File::open(&config.state_dir)
+        .and_then(|f| f.sync_all())
+        .map_err(|_| storage_error())?;
+    record.complete = true;
+    save(config, record)
+}
+
+/// Complete with the evidence `confirm_receipt` returned. A finalized escape
+/// whose payout the vault credited closed the note too; the status then
+/// reports the credit instead of a paid close.
+pub(crate) fn complete_confirmed(
+    config: &AuthConfig,
+    record: &mut Reservation,
+    hash: &str,
+    evidence: CloseEvidence,
+) -> Result<(), AuthError> {
+    record.escape_payout_credited = evidence.escape_payout_credited;
+    complete(config, record, hash)
+}
+
+async fn rpc(config: &AuthConfig, method: &str, params: Value) -> Result<Value, AuthError> {
+    let failure = || {
+        AuthError::Wallet("withdrawal RPC unavailable or invalid; preserve saved progress".into())
+    };
+    let url = config.demo_rpc_url.as_deref().ok_or_else(failure)?;
+    let parsed = reqwest::Url::parse(url).map_err(|_| failure())?;
+    // Only this crate's unit tests may serve the RPC over loopback HTTP.
+    let loopback_test_rpc =
+        cfg!(test) && parsed.scheme() == "http" && parsed.host_str() == Some("127.0.0.1");
+    if (parsed.scheme() != "https" && !loopback_test_rpc)
+        || !parsed.username().is_empty()
+        || parsed.password().is_some()
+        || parsed.fragment().is_some()
+    {
+        return Err(failure());
+    }
+    // New clients inherit the daemon's authenticated local CONNECT proxy,
+    // using direct TCP or Wisp with no fallback or account authorization header.
+    let client = reqwest::Client::builder()
+        .timeout(Duration::from_secs(20))
+        .redirect(reqwest::redirect::Policy::none())
+        .build()
+        .map_err(|_| failure())?;
+    let mut response = client
+        .post(url)
+        .json(&json!({"jsonrpc":"2.0","id":1,"method":method,"params":params}))
+        .send()
+        .await
+        .map_err(|_| failure())?;
+    if !response.status().is_success() {
+        return Err(failure());
+    }
+    let mut bytes = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|_| failure())? {
+        if bytes.len() + chunk.len() > 1 << 20 {
+            return Err(failure());
+        }
+        bytes.extend_from_slice(&chunk);
+    }
+    let response: Value = serde_json::from_slice(&bytes).map_err(|_| failure())?;
+    if response["id"] != 1
+        || response["jsonrpc"] != "2.0"
+        || response.get("error").is_some()
+        || response.get("result").is_none()
+    {
+        return Err(failure());
+    }
+    Ok(response["result"].clone())
+}
+
+fn quantity(value: &Value) -> Result<u64, AuthError> {
+    let text = value.as_str().ok_or_else(storage_error)?;
+    u64::from_str_radix(text.strip_prefix("0x").ok_or_else(storage_error)?, 16)
+        .map_err(|_| storage_error())
+}
+
+/// What a matching payout receipt shows.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct CloseEvidence {
+    /// The receipt's escape closed the note, but the vault could not push the
+    /// balance to the destination and credited it to
+    /// `escapePayoutCredits(destination)`: `EscapePayoutDeferred` for this
+    /// note and destination precedes `EscapeWithdrawalFinalized`. Nothing has
+    /// reached the destination until `claimEscapePayout(destination)`.
+    pub escape_payout_credited: bool,
+}
+
+pub(crate) fn validate_close_event(
+    record: &Reservation,
+    receipt: &Value,
+    hash: &str,
+) -> Result<CloseEvidence, AuthError> {
+    if receipt["status"] != "0x1"
+        || !receipt["transactionHash"]
+            .as_str()
+            .is_some_and(|value| value.eq_ignore_ascii_case(hash))
+    {
+        return Err(AuthError::InvalidInput(
+            "withdrawal receipt is not a successful matching transaction".into(),
+        ));
+    }
+    // A finalized escape is the only other payout of this note, for example
+    // after the clearance ownership proof was submitted as an escape. Both
+    // events carry the same fields, which must match the reservation exactly.
+    let topics = [
+        b"MutualClose(uint32,uint256,uint128,address)".as_slice(),
+        b"EscapeWithdrawalFinalized(uint32,uint256,uint128,address)".as_slice(),
+    ]
+    .map(|signature| format!("0x{:x}", Keccak256::digest(signature)));
+    let vault = hex(&record.snapshot.contract_address.as_bytes()[12..]);
+    let note_topic = format!("0x{:064x}", record.snapshot.note_id);
+    // All event parameters except indexed noteId are fixed ABI words.
+    let expected_data = format!(
+        "{}{:064x}{}{}",
+        hex(record.nullifier.as_bytes()),
+        record.snapshot.current_balance,
+        "0".repeat(24),
+        &hex(&record.destination)[2..]
+    );
+    let matches: Vec<&Value> = receipt["logs"]
+        .as_array()
+        .ok_or_else(storage_error)?
+        .iter()
+        .filter(|log| {
+            log["removed"] != true
+                && log["address"]
+                    .as_str()
+                    .is_some_and(|value| value.eq_ignore_ascii_case(&vault))
+                && log["topics"].as_array().is_some_and(|log_topics| {
+                    log_topics.len() == 2
+                        && log_topics[0].as_str().is_some_and(|value| {
+                            topics.iter().any(|topic| value.eq_ignore_ascii_case(topic))
+                        })
+                        && log_topics[1]
+                            .as_str()
+                            .is_some_and(|value| value.eq_ignore_ascii_case(&note_topic))
+                })
+                && log["data"]
+                    .as_str()
+                    .is_some_and(|value| value.eq_ignore_ascii_case(&expected_data))
+        })
+        .collect();
+    if matches.len() != 1 {
+        return Err(AuthError::InvalidInput(
+            "withdrawal receipt has no unique matching MutualClose or EscapeWithdrawalFinalized payout event".into(),
+        ));
+    }
+    // A vault with vault_revision 2 credits an escape payout that the
+    // destination rejects, or that needs more than 100,000 gas to receive.
+    // Whatever amount it names, a deferral for this note and destination
+    // means the destination was not paid. A mutual close pays in full or
+    // reverts, so only an escape can be credited.
+    let escape = matches[0]["topics"][0]
+        .as_str()
+        .is_some_and(|value| value.eq_ignore_ascii_case(&topics[1]));
+    let deferred = format!(
+        "0x{:x}",
+        Keccak256::digest(b"EscapePayoutDeferred(uint32,address,uint128)")
+    );
+    let destination_topic = format!("0x{}{}", "0".repeat(24), &hex(&record.destination)[2..]);
+    let escape_payout_credited = escape
+        && receipt["logs"]
+            .as_array()
+            .ok_or_else(storage_error)?
+            .iter()
+            .any(|log| {
+                log["removed"] != true
+                    && log["address"]
+                        .as_str()
+                        .is_some_and(|value| value.eq_ignore_ascii_case(&vault))
+                    && log["topics"].as_array().is_some_and(|log_topics| {
+                        log_topics.len() == 3
+                            && [&deferred, &note_topic, &destination_topic]
+                                .iter()
+                                .zip(log_topics)
+                                .all(|(expected, topic)| {
+                                    topic
+                                        .as_str()
+                                        .is_some_and(|value| value.eq_ignore_ascii_case(expected))
+                                })
+                    })
+            });
+    Ok(CloseEvidence {
+        escape_payout_credited,
+    })
+}
+
+pub(crate) async fn confirm_receipt(
+    config: &AuthConfig,
+    record: &Reservation,
+    hash: &str,
+) -> Result<CloseEvidence, AuthError> {
+    confirm_receipt_using(config, record, hash, |method, params| {
+        rpc(config, method, params)
+    })
+    .await
+}
+
+async fn confirm_receipt_using<F, Fut>(
+    config: &AuthConfig,
+    record: &Reservation,
+    hash: &str,
+    mut request: F,
+) -> Result<CloseEvidence, AuthError>
+where
+    F: FnMut(&'static str, Value) -> Fut,
+    Fut: std::future::Future<Output = Result<Value, AuthError>>,
+{
+    hex_bytes(hash, 32)?;
+    if quantity(&request("eth_chainId", json!([])).await?)? != config.chain_id {
+        return Err(AuthError::WithdrawalConflict);
+    }
+    let receipt = request("eth_getTransactionReceipt", json!([hash])).await?;
+    if receipt.is_null() {
+        return Err(AuthError::OaWithdrawalPending);
+    }
+    let evidence = validate_close_event(record, &receipt, hash)?;
+    let number = quantity(&receipt["blockNumber"])?;
+    let hash = receipt["blockHash"].as_str().ok_or_else(storage_error)?;
+    hex_bytes(hash, 32)?;
+    let finalized = request("eth_getBlockByNumber", json!(["finalized", false])).await?;
+    if quantity(&finalized["number"])? < number {
+        return Err(AuthError::OaWithdrawalPending);
+    }
+    let canonical = request(
+        "eth_getBlockByNumber",
+        json!([receipt["blockNumber"], false]),
+    )
+    .await?;
+    if quantity(&canonical["number"])? != number
+        || !canonical["hash"]
+            .as_str()
+            .is_some_and(|value| value.eq_ignore_ascii_case(hash))
+    {
+        return Err(AuthError::OaWithdrawalPending);
+    }
+    if quantity(&request("eth_chainId", json!([])).await?)? != config.chain_id {
+        return Err(AuthError::WithdrawalConflict);
+    }
+    Ok(evidence)
+}
