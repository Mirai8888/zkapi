+        let mut changed = note.clone();
+        changed.current_balance -= 1;
+        changed
+            .save(&config.state_dir.join("note_state.json"))
+            .unwrap();
+        assert!(matches!(
+            service
+                .oa_release_withdrawal(note.note_id, record.nullifier)
