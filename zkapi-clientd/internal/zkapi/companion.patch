+            serde_json::json!({"status":"ok","nullifier_status":"clearance_reserved"}),
+            serde_json::json!({"status":"ok","nullifier_status":"reserved"}),
+            serde_json::json!({"status":"ok","nullifier_status":"finalized"}),
