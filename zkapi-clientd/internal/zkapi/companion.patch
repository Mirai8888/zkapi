+    use super::*;
+    use ring::signature::{Ed25519KeyPair, KeyPair};
+    use serde_json::json;
+    use sha2::{Digest, Sha256};
+
+    struct SignedEvidence {
+        public: String,
+        evidence: OaKeyVerificationEvidence,
+    }
+
+    impl SignedEvidence {
+        fn new(url: &str) -> Self {
+            let pair = Ed25519KeyPair::from_seed_unchecked(&[7; 32]).unwrap();
+            let key_valid_till = now_seconds() + 330;
+            let signature = pair.sign(format!("oa-station|test-key|{key_valid_till}").as_bytes());
+            Self {
+                public: pair.public_key().as_ref().iter().map(|b| format!("{b:02x}")).collect(),
+                evidence: OaKeyVerificationEvidence {
+                    verifier_url: url.into(), station_id: "oa-station".into(), station_recently_attested: false,
+                    key_valid_till, station_signature: signature.as_ref().iter().map(|b| format!("{b:02x}")).collect(),
+                    org_signature: "cd".repeat(64),
+                },
+            }
+        }
+        fn trust<'a>(&'a self, url: &'a str) -> StationTrust<'a> {
+            StationTrust { station_id: "oa-station", public_key_hex: &self.public, verifier_url: url }
+        }
+        fn expiry(&self) -> u64 { self.evidence.key_valid_till - 30 }
+    }
+
+    fn service(url: &str, directory: &std::path::Path) -> Arc<AuthService> {
+        AuthService::new(AuthConfig { state_dir: directory.into(), oa_verifier_url: url.into(), ..Default::default() }).unwrap()
+    }
+
+    #[test]
+    fn every_advisory_fallback_requires_a_pinned_signed_key() {
+        let url = TRUSTED_STATION.verifier_url;
+        let signed = SignedEvidence::new(url);
+        let trust = signed.trust(url);
+        let mut unknown = signed.evidence.clone();
+        unknown.station_id = "unknown".into();
+        unknown.station_recently_attested = true;
+        for (status, body) in [
+            (None, Value::Null),
+            (Some(200), json!({"status":"unverified","ownership_passed":false})),
+            (Some(200), json!({"status":"pending"})),
+            (Some(401), json!({"detail":"Invalid org signature"})),
+            (Some(403), json!({"status":"rejected","detail":"ownership check failed"})),
+            (Some(408), json!({"status":"error"})),
+            (Some(429), json!({"status":"error"})),
+            (Some(500), json!({"status":"error"})),
+            (Some(502), json!({"status":"error"})),
+            (Some(503), json!({"status":"unverified","detail":"ownership_check_error"})),
+            (Some(504), json!({"status":"error"})),
+        ] {
+            let result = oa_verifier_outage(status, &body, signed.expiry(), &signed.evidence, "test-key", url, trust).unwrap();
+            assert!(!result.verified);
+            assert_eq!(result.detail, Some("trusted_station_fallback"));
+            assert!(oa_verifier_outage(status, &body, signed.expiry(), &unknown, "test-key", url, trust).is_err(), "{status:?} {body}");
+        }
+        for (status, body) in [
+            (307, json!({})), (308, json!({})), (200, json!({"status":123})),
+            (401, json!({"detail":"Station is banned"})),
+            (503, json!({"status":"banned"})),
+            (503, json!({"banned_station":{"station_id":"oa-station"}})),
+            (503, json!({"error":{"detail":"key expired"}})),
+            (200, json!({"status":"expired"})),
+        ] {
+            assert!(oa_verifier_outage(Some(status), &body, signed.expiry(), &signed.evidence, "test-key", url, trust).is_err());
+        }
+        assert!(oa_verifier_outage(None, &Value::Null, now_seconds()-1, &signed.evidence, "test-key", url, trust).is_err());
+        assert!(oa_verifier_outage(None, &Value::Null, signed.expiry(), &signed.evidence, "swapped-key", url, trust).is_err());
+        assert!(oa_verifier_outage(None, &Value::Null, signed.expiry(), &signed.evidence, "test-key", "https://other.example", trust).is_err());
+        let mut swapped = signed.evidence.clone(); swapped.key_valid_till += 1;
+        assert!(oa_verifier_outage(None, &Value::Null, signed.expiry(), &swapped, "test-key", url, trust).is_err());
+        swapped = signed.evidence.clone(); swapped.station_signature = "ab".repeat(64);
+        assert!(oa_verifier_outage(None, &Value::Null, signed.expiry(), &swapped, "test-key", url, trust).is_err());
+        swapped = signed.evidence.clone(); swapped.verifier_url = "https://other.example".into();
+        assert!(oa_verifier_outage(None, &Value::Null, signed.expiry(), &swapped, "test-key", url, trust).is_err());
+        // Tests cannot accidentally depend on possession of the real operator signing key.
+        assert!(oa_verifier_outage(None, &Value::Null, signed.expiry(), &signed.evidence, "test-key", url, TRUSTED_STATION).is_err());
+    }
