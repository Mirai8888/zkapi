+    /// A server that already holds a clearance for the state (for example
+    /// after the operator released a stuck state, or an earlier proof-less
+    /// clearance) and now requires an ownership proof leaves a state no chat
+    /// request can settle, before expiry too. It is reported apart, keeps the
+    /// reservation, and the owner's acknowledgement sends the proof.
+    #[tokio::test]
+    async fn a_clearance_reserved_state_sends_its_ownership_proof_only_with_the_owners_acknowledgement(
+    ) {
+        let reserved = |accept| Setup {
+            accept_unsettled_request_risk: accept,
+            again: accept,
+            ..Setup::new(
+                Archive::Record,
+                Clearance::RequireProof,
+                "clearance_reserved",
+            )
+        };
+        let run = prepare_with_setup(reserved(false)).await;
+        assert!(
+            matches!(
+                &run.result,
+                Err(AuthError::UnsettledStateClearanceReserved(_))
+            ),
+            "{:?}",
+            run.result
+        );
+        assert_eq!(
+            run.result.as_ref().unwrap_err().code(),
+            "unsettled_clearance_reserved"
+        );
+        assert_eq!(run.phase, "reserved");
+        assert!(run.requests.len() == 1 && run.requests[0].ownership_proof.is_none());
+
+        let run = prepare_with_setup(reserved(true)).await;
+        assert!(run.result.is_ok(), "{:?}", run.result);
+        assert!(matches!(run.again, Some(Ok(_))), "{:?}", run.again);
+        assert_eq!(run.requests.len(), 3);
+        assert!(run.requests[0].ownership_proof.is_none());
+        assert!(run.requests[1..]
+            .iter()
+            .all(|request| request.ownership_proof.is_some()));
+    }
+
+    /// sdk cross-component request 2: once a clearance request carrying an
+    /// ownership proof has left, whatever answer follows (a gateway 429, a
+    /// 5xx, an answer that is no clearance) may come from someone who kept
+    /// the proof, a submittable escape at this nullifier. On a vault below
+    /// revision 2 a request proof from the same state would let them escape
+    /// and challenge, which burns the nullifier. The reservation records the
+    /// proof before the request leaves and is then never released, not even
+    /// on the server's unsigned "unknown" reading, so no lease is made from
+    /// that state. Closing again is the way out. A hardened vault restores a
+    /// challenged nullifier, so there the reservation is released as before.
+    #[tokio::test]
+    async fn an_ownership_proof_that_left_keeps_the_reservation_on_a_legacy_vault() {
+        for clearance in [
+            Clearance::GatewayThrottled,
+            Clearance::ServerFailure,
+            Clearance::Garbled,
+        ] {
+            for vault_revision in [0, 2] {
+                let case = format!("{clearance:?}, vault_revision {vault_revision}");
+                let run = prepare_with_setup(Setup {
+                    vault_revision,
+                    follow_up: true,
+                    ..Setup::new(Archive::Empty, clearance, "unknown")
+                })
+                .await;
+                assert!(run.result.is_err(), "{case}: {:?}", run.result);
+                assert!(!run.requests.is_empty(), "{case}");
+                assert!(
+                    run.requests
+                        .iter()
+                        .all(|request| request.ownership_proof.is_some()),
+                    "{case}"
+                );
+                assert_eq!(run.ownership_proof_sent, Some(true), "{case}");
+                let (released, lease, reads) = run.follow_up.unwrap();
+                if vault_revision >= 2 {
+                    assert_eq!(released.unwrap()["phase"], "none", "{case}");
+                    assert_eq!(run.phase, "none", "{case}");
+                    continue;
+                }
+                match &released {
+                    Err(error @ AuthError::OwnershipProofSent) => {
+                        assert_eq!(error.code(), "ownership_proof_sent", "{case}");
+                        assert_eq!(
+                            error.status_code(),
+                            axum::http::StatusCode::CONFLICT,
+                            "{case}"
+                        );
+                    }
+                    other => panic!("{case}: {other:?}"),
+                }
+                assert_eq!(reads, 0, "{case}: refused before asking the server");
+                assert_eq!(run.phase, "reserved", "{case}");
+                assert!(
+                    matches!(lease, Some(Err(AuthError::WithdrawalConflict))),
+                    "{case}: {lease:?}"
+                );
+            }
+        }
+
+        // Closing again completes the close.
+        let run = prepare_with_setup(Setup {
+            again: true,
+            ..Setup::new(Archive::Empty, Clearance::ThrottledOnce, "unknown")
+        })
+        .await;
+        assert!(run.result.is_err(), "{:?}", run.result);
+        assert!(matches!(run.again, Some(Ok(_))), "{:?}", run.again);
+        assert_eq!(run.requests.len(), 2);
+        assert!(run
+            .requests
+            .iter()
+            .all(|request| request.ownership_proof.is_some()));
+        assert_eq!(run.ownership_proof_sent, Some(true));
+        assert_eq!(run.phase, "reserved");
+
+        // A state that the archive marks unsettled only after the proof left
+        // gains nothing from a proof-less request: the retry sends the proof
+        // again and closes, instead of stopping at a refusal it cannot get
+        // past.
+        let run = prepare_with_setup(Setup {
+            again: true,
+            archive_before_again: true,
+            ..Setup::new(Archive::Empty, Clearance::ThrottledOnce, "unknown")
+        })
+        .await;
+        assert!(matches!(run.again, Some(Ok(_))), "{:?}", run.again);
+        assert!(run
+            .requests
+            .iter()
+            .all(|request| request.ownership_proof.is_some()));
+    }
+
+    /// sdk cross-component request 1, with a throttling gateway: at a state
+    /// with an unsettled request on a legacy vault the clearance request
+    /// carries no ownership proof, also when a gateway answers 429. Nothing
+    /// submittable left, so the reservation is still released on the
+    /// server's unknown reading and the note can settle its state.
+    #[tokio::test]
+    async fn a_throttled_proof_less_clearance_sends_no_proof_and_stays_releasable() {
+        let run = prepare_with_setup(Setup {
+            follow_up: true,
+            ..Setup::new(Archive::Record, Clearance::GatewayThrottled, "unknown")
+        })
+        .await;
+        assert!(run.result.is_err(), "{:?}", run.result);
+        assert!(!run.requests.is_empty());
+        assert!(run
+            .requests
+            .iter()
+            .all(|request| request.ownership_proof.is_none()));
+        assert_eq!(run.ownership_proof_sent, Some(false));
+        let (released, _, reads) = run.follow_up.unwrap();
+        assert_eq!(released.unwrap()["phase"], "none");
+        assert_eq!(reads, 1);
+        assert_eq!(run.phase, "none");
+    }
