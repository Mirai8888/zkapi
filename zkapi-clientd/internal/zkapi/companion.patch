+fn reserve_oa_bridge_lease(state_dir: &Path, lease_id: &str) -> Result<(), AuthError> {
+    use sha3::{Digest, Keccak256};
+    #[cfg(unix)]
+    use std::os::unix::fs::OpenOptionsExt;
+    let directory = state_dir.join("oa-issued-leases");
+    std::fs::create_dir_all(&directory).map_err(|_| AuthError::Wallet("cannot persist lease reservation".into()))?;
+    std::fs::File::open(state_dir).and_then(|file| file.sync_all())
+        .map_err(|_| AuthError::Wallet("cannot sync lease reservation parent".into()))?;
+    let name = format!("{:x}", Keccak256::digest(lease_id.as_bytes()));
+    let mut options = OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    options.mode(0o600);
+    let file = options.open(directory.join(name)).map_err(|error| {
+        if error.kind() == std::io::ErrorKind::AlreadyExists {
+            AuthError::LeasePending("this key has already been used; wait for settlement before requesting another".into())
+        } else {
+            AuthError::Wallet("cannot persist lease reservation".into())
+        }
+    })?;
+    file.sync_all().map_err(|_| AuthError::Wallet("cannot sync lease reservation".into()))?;
+    std::fs::File::open(&directory).and_then(|file| file.sync_all())
+        .map_err(|_| AuthError::Wallet("cannot sync lease reservation directory".into()))?;
+    Ok(())
+}
