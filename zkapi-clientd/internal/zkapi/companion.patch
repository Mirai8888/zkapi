+        let mut wallet = load_wallet(&config, Vec::new()).unwrap();
+        wallet.confirm_deposit(Felt252::from_u64(42), 7, 1_500_000, 4_000_000_000).unwrap();
+        let note = wallet.state().unwrap();
+        let nullifier = core_v2::nullifier(&note.secret_s, &note.current_anchor);
+        let anonymous = rerandomize(&CurvePointWire {
+            x: note.current_commitment_x, y: note.current_commitment_y,
+        }, &Felt252::ONE).unwrap();
+        // This intentionally expired quote must be replayed byte-for-byte.
+        let quote = json!({"asset":"native_eth","units_per_eth":1_000_000_000,"chain_id":1,
+            "feed_address":config.native_price_feed_address,"round_id":"123","answer":"250000000000",
+            "decimals":8,"updated_at":1,"expires_at":3601});
+        let payload = json!({"mode":"openrouter_ephemeral_lease","version":1,"billing_quote":quote}).to_string();
