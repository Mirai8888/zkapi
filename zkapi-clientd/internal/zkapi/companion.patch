+        note.save(&config.state_dir.join("note_state.json"))
+            .unwrap();
+        assert_eq!(
+            calls_made(),
+            0,
+            "local refusals happen before any server request"
+        );
+
+        // Any server answer other than unknown may mean a clearance exists.
