+    let mut source: Option<&(dyn Error + 'static)> = Some(error);
+    while let Some(cause) = source {
+        let text = cause.to_string().to_ascii_lowercase();
+        if ["certificate", "cert ", "tls", "ssl", "invalid peer", "unknown issuer", "proxy authentication", "canceled", "cancelled"].iter().any(|term| text.contains(term)) { return false; }
