+fn oa_key_expiry_covers_lease(key_valid_till: u64, lease_expires_at: u64) -> bool {
+    key_valid_till.checked_sub(lease_expires_at)
+        .is_some_and(|safety_margin| safety_margin <= MAX_OA_EVIDENCE_EXPIRY_SKEW_SECONDS)
+}
