+    async fn ready_direct_lease(&self, request_limit_micro_usd: u128) -> Result<tokio::sync::MutexGuard<'_, Option<ActiveOpenRouterLease>>, AuthError> {
+        use sha3::{Digest, Keccak256};
+        self.ensure_scheme_agreement().await?;
+        let mut slot = self.direct_lease.lock().await;
+        self.oa_check_spending().await?;
+        if let Some(lease) = slot.as_ref() {
+            let marker = self.config.state_dir.join("oa-issued-leases")
+                .join(format!("{:x}", Keccak256::digest(lease.client_request_id.as_bytes())));
+            if marker.exists() {
+                let recovered = self.recover().await?;
+                if recovered.wallet.pending_request {
+                    return Err(AuthError::LeasePending("the previous API request is awaiting lease settlement".into()));
+                }
+                *slot = None;
+            }
+        }
+        self.ensure_direct_openrouter_lease(&mut slot, "oa-single-use", Some(request_limit_micro_usd)).await?;
+        let request = self.prepare_direct_lease_request(None).await?;
+        self.check_request_budget(&request, request_limit_micro_usd)?;
+        let lease = slot.as_mut().ok_or_else(|| AuthError::Wallet("lease disappeared".into()))?;
+        let evidence = lease.verification.as_ref().ok_or_else(|| AuthError::KeyVerification("missing OA key evidence".into()))?;
+        let outcome = self.verify_oa_key(&lease.api_key, lease.expires_at, evidence).await?;
+        if now_seconds().saturating_add(1) >= lease.expires_at {
+            return Err(AuthError::KeyVerification("key expired during verification".into()));
+        }
+        lease.verified = outcome.verified;
+        lease.verification_detail = outcome.detail.map(str::to_string);
+        Ok(slot)
+    }
