+        let verifier = WithdrawalVerifier::load(SETUP_DIR).unwrap();
+        assert!(verifier
+            .verify(&ownership.public_inputs, &ownership.proof)
+            .unwrap());
+        assert!(verifier.verify(&public, &proof).unwrap());
+    }
